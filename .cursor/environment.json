{
  "name": "RevCollect",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "dev",
      "command": "export PATH=\"$HOME/.bun/bin:$PATH\"; cd /workspace && bun run dev",
      "description": "Next.js dev server (RevCollect) on http://localhost:3000"
    }
  ],
  "ports": [
    { "name": "web", "port": 3000 },
    { "name": "supabase-api", "port": 54321 },
    { "name": "supabase-mail", "port": 54324 }
  ]
}
